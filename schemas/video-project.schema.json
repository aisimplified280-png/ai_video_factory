{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Simplified Lab Video Project",
  "type": "object",
  "required": [
    "project_id",
    "topic",
    "format",
    "channel_profile",
    "scenes",
    "delivery"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "topic": {
      "type": "object",
      "required": [
        "working_title",
        "production_class"
      ],
      "properties": {
        "working_title": {
          "type": "string"
        },
        "production_class": {
          "enum": [
            "explanatory",
            "cinematic",
            "screen_demo",
            "hybrid"
          ]
        },
        "research_brief": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "aspect_ratio",
        "width",
        "height"
      ],
      "properties": {
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9"
          ]
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "type": "integer",
          "default": 30
        }
      }
    },
    "channel_profile": {
      "type": "object",
      "required": [
        "channel_name",
        "faceless",
        "narration_language"
      ],
      "properties": {
        "channel_name": {
          "type": "string"
        },
        "faceless": {
          "type": "boolean"
        },
        "narration_language": {
          "type": "string"
        },
        "audience_notes": {
          "type": "string"
        },
        "visual_profile": {
          "type": "string"
        },
        "subscribe_cta": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "purpose",
          "duration_seconds",
          "visual_mode"
        ],
        "properties": {
          "scene_id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "visual_mode": {
            "enum": [
              "previs_3d",
              "generated_video",
              "generated_image_motion",
              "diagram",
              "kinetic_type",
              "chart",
              "screen_capture",
              "stock_licensed",
              "code_animation"
            ]
          },
          "narration_text": {
            "type": "string"
          },
          "overlay_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "provider": {
            "type": "string"
          },
          "provider_profile": {
            "type": "string"
          },
          "asset_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "camera_motion": {
            "type": "string"
          },
          "sound_design": {
            "type": "string"
          },
          "licence_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval_status": {
            "enum": [
              "planned",
              "approved",
              "generated",
              "rejected"
            ]
          },
          "sceneDirection": {
            "$ref": "#/$defs/dynamicSceneDirection"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "voice_provider": {
          "type": "string"
        },
        "voice_id": {
          "type": "string"
        },
        "music_provider": {
          "type": "string"
        },
        "music_licence": {
          "type": "string"
        },
        "sfx_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "properties": {
        "editor_provider": {
          "type": "string"
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "captions_file": {
          "type": "string"
        },
        "render_profile": {
          "type": "string"
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "container",
        "video_codec",
        "audio_codec",
        "target_resolution"
      ],
      "properties": {
        "container": {
          "const": "mp4"
        },
        "video_codec": {
          "const": "h264"
        },
        "audio_codec": {
          "const": "aac"
        },
        "audio_sample_rate_hz": {
          "type": "integer",
          "default": 48000
        },
        "target_resolution": {
          "enum": [
            "1080x1920",
            "1920x1080"
          ]
        },
        "thumbnail_file": {
          "type": "string"
        },
        "srt_file": {
          "type": "string"
        },
        "youtube_package_file": {
          "type": "string"
        }
      }
    },
    "cost_preflight": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "action",
          "cost_status"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "cost_status": {
            "enum": [
              "free_verified",
              "quoted",
              "unknown",
              "user_approved"
            ]
          },
          "quoted_cost": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "approval_reference": {
            "type": "string"
          }
        }
      }
    },
    "productionMode": {
      "enum": [
        "dynamic",
        "legacy"
      ],
      "default": "dynamic"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "url",
        "accessed_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "publisher": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "claim_supported": {
          "type": "string"
        }
      }
    },
    "dynamicSceneDirection": {
      "type": "object",
      "required": [
        "narrativePurpose",
        "visualIntent",
        "visualMetaphor",
        "primarySubject",
        "composition",
        "visualEvent",
        "elements",
        "choreography",
        "audio",
        "captions",
        "transition"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "narrativePurpose": {
          "type": "string",
          "minLength": 1
        },
        "visualIntent": {
          "type": "string",
          "minLength": 1
        },
        "visualMetaphor": {
          "type": "string",
          "minLength": 1
        },
        "primarySubject": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "object",
          "required": [
            "signature",
            "shotType",
            "camera",
            "depthLayers",
            "focalHierarchy",
            "negativeSpace"
          ],
          "properties": {
            "signature": {
              "type": "string",
              "minLength": 1
            },
            "shotType": {
              "type": "string",
              "minLength": 1
            },
            "camera": {
              "type": "object",
              "required": [
                "move",
                "target",
                "path",
                "animation"
              ],
              "properties": {
                "move": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "animation": {
                  "type": "object",
                  "required": [
                    "from",
                    "to",
                    "duration"
                  ],
                  "properties": {
                    "from": {
                      "type": "object",
                      "minProperties": 1,
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "scale": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "rotation": {
                          "type": "number"
                        },
                        "opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "to": {
                      "type": "object",
                      "minProperties": 1,
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "scale": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "rotation": {
                          "type": "number"
                        },
                        "opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "ease": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "depthLayers": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string"
              }
            },
            "focalHierarchy": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "negativeSpace": {
              "type": "string"
            },
            "environment": {
              "type": "object",
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "atmosphere": {
                  "type": "string"
                }
              }
            }
          }
        },
        "visualEvent": {
          "type": "object",
          "required": [
            "setup",
            "action",
            "payoff"
          ],
          "properties": {
            "setup": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "payoff": {
              "type": "string"
            }
          }
        },
        "elements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "role",
              "purpose",
              "source",
              "geometry",
              "appearance",
              "motionRole"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "role": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "procedural",
                  "original",
                  "generated",
                  "licensed",
                  "captured"
                ]
              },
              "geometry": {
                "type": "object",
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rotation": {
                    "type": "number"
                  },
                  "endX": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "endY": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "appearance": {
                "type": "object",
                "required": [
                  "primitive"
                ],
                "properties": {
                  "primitive": {
                    "enum": [
                      "orb",
                      "ring",
                      "capsule",
                      "packet",
                      "rail",
                      "beam",
                      "node",
                      "panel",
                      "label",
                      "particle-field",
                      "image"
                    ]
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "accent": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "label": {
                    "type": "string"
                  },
                  "material": {
                    "type": "string"
                  },
                  "assetPath": {
                    "type": "string"
                  }
                }
              },
              "motionRole": {
                "type": "string"
              },
              "licenseEvidence": {
                "type": "string"
              }
            }
          }
        },
        "choreography": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "trigger",
              "target",
              "event",
              "duration",
              "pathOrChange",
              "purpose",
              "animation",
              "causeAndEffect",
              "reactionMotions",
              "soundCue"
            ],
            "properties": {
              "trigger": {
                "type": "object",
                "required": [
                  "type",
                  "anchor"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "spoken-phrase",
                      "timecode"
                    ]
                  },
                  "anchor": {
                    "type": "string"
                  }
                }
              },
              "target": {
                "type": "string"
              },
              "event": {
                "type": "string"
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "pathOrChange": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "animation": {
                "type": "object",
                "required": [
                  "from",
                  "to",
                  "duration"
                ],
                "properties": {
                  "from": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "scale": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "rotation": {
                        "type": "number"
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "to": {
                    "type": "object",
                    "minProperties": 1,
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      },
                      "scale": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "rotation": {
                        "type": "number"
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  "duration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "ease": {
                    "type": "string"
                  }
                }
              },
              "causeAndEffect": {
                "type": "object",
                "required": [
                  "reacts",
                  "reaction"
                ],
                "properties": {
                  "reacts": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "reaction": {
                    "type": "string"
                  }
                }
              },
              "reactionMotions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "target",
                    "from",
                    "to",
                    "duration"
                  ],
                  "properties": {
                    "target": {
                      "type": "string"
                    },
                    "from": {
                      "type": "object",
                      "minProperties": 1,
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "scale": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "rotation": {
                          "type": "number"
                        },
                        "opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "to": {
                      "type": "object",
                      "minProperties": 1,
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "scale": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "rotation": {
                          "type": "number"
                        },
                        "opacity": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "ease": {
                      "type": "string"
                    }
                  }
                }
              },
              "soundCue": {
                "type": "object",
                "required": [
                  "type",
                  "assetKey",
                  "offsetSeconds",
                  "purpose"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "assetKey": {
                    "type": "string"
                  },
                  "offsetSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "purpose": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "audio": {
          "type": "object",
          "required": [
            "voiceSegment",
            "ambience",
            "musicCue",
            "ducking"
          ],
          "properties": {
            "voiceSegment": {
              "type": "string"
            },
            "ambience": {
              "type": "string"
            },
            "musicCue": {
              "type": "string"
            },
            "ducking": {
              "type": "string"
            }
          }
        },
        "captions": {
          "type": "object",
          "required": [
            "mode",
            "anchor",
            "treatment",
            "placement",
            "style"
          ],
          "properties": {
            "mode": {
              "enum": [
                "word-synced",
                "phrase-synced"
              ]
            },
            "emphasis": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "anchor": {
              "type": "string"
            },
            "treatment": {
              "type": "string"
            },
            "placement": {
              "type": "object",
              "required": [
                "x",
                "y",
                "align",
                "maxWidth"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 95
                },
                "y": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 95
                },
                "align": {
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ]
                },
                "maxWidth": {
                  "type": "number",
                  "minimum": 240,
                  "maximum": 1080
                }
              }
            },
            "style": {
              "type": "object",
              "required": [
                "fontSize",
                "fontWeight",
                "color",
                "highlightColor",
                "activeBackgroundColor"
              ],
              "properties": {
                "fontSize": {
                  "type": "number",
                  "minimum": 18,
                  "maximum": 90
                },
                "fontWeight": {
                  "type": "number",
                  "minimum": 400,
                  "maximum": 900
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
                },
                "highlightColor": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
                },
                "activeBackgroundColor": {
                  "oneOf": [
                    {
                      "const": "transparent"
                    },
                    {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$"
                    }
                  ]
                }
              }
            }
          }
        },
        "transition": {
          "type": "object",
          "required": [
            "type",
            "continuityReason"
          ],
          "properties": {
            "type": {
              "enum": [
                "hard-cut",
                "cross-dissolve",
                "camera-continuation"
              ]
            },
            "continuityReason": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "productionMode": {
            "const": "dynamic"
          }
        },
        "required": [
          "productionMode"
        ]
      },
      "then": {
        "properties": {
          "scenes": {
            "items": {
              "required": [
                "sceneDirection"
              ]
            }
          }
        }
      }
    }
  ]
}
